# Segredos e modo de depuração
SECRET_KEY=troque-esta-chave-em-cada-ambiente
DEBUG=True

# Hosts e origens permitidas
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Configuração de banco de dados (SQLite em desenvolvimento; PostgreSQL em produção)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://usuario:senha@localhost:5432/gym365

# Internacionalização e fuso horário
TIME_ZONE=America/Fortaleza
LANGUAGE_CODE=pt-br

# Envio de e-mails transacionais e recuperação de senha
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=usuario@exemplo.com
EMAIL_HOST_PASSWORD=senha-de-exemplo
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=365 Boxe Gym <nao-responda@exemplo.com>
